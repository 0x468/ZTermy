{
    "version": 38,
    "connectionHistoryEnabled": false,
    "closePaneOnSessionEnd": true,
    "preserveTerminalSessions": true,
    "reopenLocalSessions": false,
    "reconnectRemoteSessions": true,
    "windowInteraction": {
        "singleInstance": false,
        "navigationWidth": 64,
        "navigationExpandedWidth": 260,
        "tabDoubleClick": "rename",
        "tabCloseButton": "hover"
    },
    "theme": "system",
    "backdropOpacity": 0.7,
    "backdrop": "acrylic",
    "effectsTier": "reduced",
    "terminalTheme": "nord",
    "lightTheme": "ztermy-light",
    "darkTheme": "nord",
    "accent": "theme",
    "customAccent": "#3366CC",
    "uiFontFamily": "",
    "terminalFontFamily": "Cascadia Mono",
    "terminalFontSize": 16,
    "showAllTerminalFonts": false,
    "terminalLigatures": false,
    "terminalBackgroundOpacity": 0.4,
    "cursor": "bar",
    "cursorBlink": true,
    "copyOnSelect": false,
    "keepSelectionAfterCopy": true,
    "confirmMultilinePaste": true,
    "terminalRightClick": "context-menu",
    "terminalMiddleClick": "disabled",
    "terminalWordDelimiters": " |,",
    "terminalScrollRows": 5,
    "terminalSelectionPopupEnabled": true,
    "terminalSelectionActionOrder": ["copy", "ai", "search", "highlight", "unhighlight"],
    "terminalSelectionPrimaryActions": ["copy", "ai"],
    "terminalSelectionRetainActions": ["search"],
    "localShell": "nushell",
    "sftpShowHiddenFiles": true,
    "sftpConfirmDelete": true,
    "closeToTray": false,
    "performanceMode": false,
    "credentialStorage": "automatic",
    "language": "zh_CN",
    "shortcutOverrides": {"terminal.find": "Ctrl+Alt+F"},
    "aiProvider": "openai-compatible",
    "aiBaseUrl": "https://gateway.example.test/v1",
    "aiEndpointPath": "/chat/completions",
    "aiModel": "preserved-model",
    "aiCredentialReference": "opaque-test-reference",
    "aiAutomaticContext": false,
    "aiPermission": "ask",
    "aiConversationHistoryEnabled": true,
    "aiDebugTraceEnabled": false,
    "aiReasoning": "auto",
    "aiProxy": "system",
    "aiProxyUrl": "",
    "aiProxyUsername": ""
}
